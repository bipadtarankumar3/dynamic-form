{
  "schema_version": "1.0",
  "form_id": "user_registration",
  "title": "User Registration",

  "root_entity": {
    "table": "users",
    "primary_key": "user_id"
  },

  "api": {
    "create": "/api/users",
    "update": "/api/users/:id",
    "get": "/api/users/:id",
    "list": "/api/users"
  },

  "context": {
    "roles": ["admin", "user"]
  },
  "sections": [
    {
      "section_id": "basic_info",
      "section_label": "Personal Information",
      "type": "general",
      "table": "users",
      "primary_key": "user_id",
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "type": "text",
          "db_field": "name",
          "data_type": "string",
          "required": true,
          "disabled": false,
          "readOnly": false,
          "ui": {
            "placeholder": "Enter name"
          },
          "validation": {
            "min_length": 3,
            "max_length": 100,
            "pattern": "^[a-zA-Z ]+$"
          },
          "messages": {
            "required": "Name is required",
            "min_length": "Name must be at least 3 characters",
            "max_length": "Name cannot exceed 100 characters",
            "pattern": "Only alphabets and spaces allowed"
          },
          "permissions": {
            "visible": ["admin", "user"],
            "editable": ["admin", "user"]
          }
        },

        {
          "id": "age",
          "label": "Age",
          "type": "number",
          "number_type": "integer",
          "db_field": "age",

          "ui": {
            "placeholder": "Enter age"
          },
          "required_when": {
            "name": { "not_null": true }
          },
          "validation": {
            "min": 1,
            "max": 120
          },
          "messages": {
            "required": "Age is required",
            "min": "Age must be greater than 0",
            "max": "Age cannot exceed 120"
          },
          "permissions": {
            "visible": ["admin", "user"],
            "editable": ["admin"]
          }
        },
        {
          "id": "price",
          "label": "Price",
          "type": "number",
          "number_type": "decimal",
          "db_field": "price",
          "required": true,

          "ui": {
            "placeholder": "Enter price"
          },
          "disabled_when": {
            "age": { "lt": 18 }
          },
          "validation": {
            "min": 1,
            "max": 120
          },
          "messages": {
            "required": "Price is required",
            "min": "Price must be greater than 0",
            "max": "Price cannot exceed 120"
          },
          "permissions": {
            "visible": ["admin", "user"],
            "editable": ["admin"]
